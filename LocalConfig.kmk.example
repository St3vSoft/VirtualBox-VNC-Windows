
# ============================================================
# VirtualBox Windows Build Configuration
# VNC-enabled custom build
# ============================================================

# Build configuration
VBOX_OSE = 1
VBOX_WITHOUT_HARDENING = 1

# VNC Extension Pack
VBOX_WITH_EXTPACK_VNC = 1

# Python
VBOX_BLD_PYTHON = C:/PATH/TO/PYTHON/python.exe

# Driver signing
VBOX_SIGNING_MODE = test
VBOX_CERTIFICATE_SUBJECT_NAME = VirtualBoxTest

# Disable warnings as errors
VBOX_WITH_WARNINGS_AS_ERRORS :=

# ============================================================
# Windows SDK / WDK
# ============================================================

VBOX_PATH_WIN_SDK_ROOT = C:/PATH/TO/WINDOWS/SDK
VBOX_PATH_WIN_SDK10_ROOT = C:/PATH/TO/WINDOWS/SDK

PATH_SDK_WINDDK71 = C:/PATH/TO/WINDDK

# ============================================================
# Qt 6
# ============================================================

VBOX_PATH_QT = C:/PATH/TO/Qt/6.x.x/msvc2022_64
PATH_SDK_QT6 = C:/PATH/TO/Qt/6.x.x/msvc2022_64
PATH_TOOL_QT6_BIN = C:/PATH/TO/Qt/6.x.x/msvc2022_64/bin

# ============================================================
# JDK
# ============================================================

VBOX_JAVA_HOME = C:/PATH/TO/JDK/HOME

# ============================================================
# Build tools
# ============================================================

KBUILD_DEVTOOLS = C:/PATH/TO/virtualbox/tools

PATH_TOOL_YASM = C:/PATH/TO/YASM
PATH_TOOL_NASM = C:/PATH/TO/NASM

PATH_TOOL_OPENWATCOM = C:/PATH/TO/WATCOM

# ============================================================
# WiX Toolset
# ============================================================

VBOX_WIX_PATH = C:/PATH/TO/WIX/bin

# ============================================================
# Flex / Bison
# ============================================================

TOOL_BISON_YACC = C:/PATH/TO/BISON/bison.exe
TOOL_FLEX_LEX = C:/PATH/TO/FLEX/flex.exe

# ============================================================
# Microsoft Visual C++ 2022
# ============================================================

PATH_TOOL_VCC143 = C:/PATH/TO/MSVC/14.xx.xxxxx
